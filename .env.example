# Local Vault connection. Keep the token only in your untracked .env file.
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=your-local-vault-token
VAULT_SECRET_PATH=secret/expense-tracker-fe-local

# Vault is authoritative when configured. These are offline fallbacks.
AUTH_URL=http://localhost:3200
AUTH_CLIENT_ID=your-central-oauth-client-id
AUTH_CLIENT_SECRET=your-oauth-client-secret
BETTER_AUTH_SECRET=your-better-auth-secret
DATABASE_URL=postgresql://user:password@localhost:5432/expense_tracker_auth_dev
NEXT_PUBLIC_APP_URL=http://localhost:3202
NEXT_PUBLIC_API_BASE_URL=http://localhost:8202/api/v1
PORT=3202
